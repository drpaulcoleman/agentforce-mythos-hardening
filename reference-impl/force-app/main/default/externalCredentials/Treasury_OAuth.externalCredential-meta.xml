<?xml version="1.0" encoding="UTF-8"?>
<!--
    Treasury_OAuth (External Credential)
    Pillar V.1 -- modern decomposition of the credential from the endpoint.
    Pairs with Treasury_API.namedCredential above. Supports per-user named
    principals so that each end-user's actions are attributed individually
    at the external system.

    NOT official Salesforce documentation. Validate against current Metadata API.
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authProtocol>Oauth</authProtocol>
    <description>External Credential paired with Treasury_API NamedCredential for OAuth + per-user named principals.</description>
    <label>Treasury OAuth</label>
</ExternalCredential>
<!--
    Schema note: the ExternalCredential metadata element is <authProtocol>, NOT
    <authenticationProtocol>. Valid values include NoAuthentication, Custom,
    Oauth, AwsSv4, JwtExchange, Password. See:
    https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_externalcredential.htm
    For a working integration, also add a <parameters> block defining at least
    one named principal; this skeleton is intentionally minimal for the
    whitepaper pairing example.
-->

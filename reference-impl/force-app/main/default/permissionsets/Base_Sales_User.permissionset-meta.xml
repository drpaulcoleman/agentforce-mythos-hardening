<?xml version="1.0" encoding="UTF-8"?>
<!--
    Base_Sales_User
    Pillar II.2 / App. E in the whitepaper -- composable Permission Set
    representing the baseline a sales-track user gets. Combine with Manager_Scope
    + Quote_Creator (via Sales_Manager.permissionsetgroup) for the manager profile.

    NOT official Salesforce documentation. Validate against the current
    PermissionSet metadata schema for your target API version before deploying.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Baseline read + own-record CRUD on Account, Contact, Opportunity. The foundational tier of the Sales_Manager PSG composition.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Base Sales User</label>
    <license>Salesforce</license>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Opportunity</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>RunReports</name>
    </userPermissions>
</PermissionSet>

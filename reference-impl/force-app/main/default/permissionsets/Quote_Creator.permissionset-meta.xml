<?xml version="1.0" encoding="UTF-8"?>
<!--
    Quote_Creator
    Pillar II.2 / App. E -- granular Permission Set granting Quote object permissions.
    Decomposed away from the manager profile so that non-manager roles (e.g., a sales
    coordinator) can be granted Quote creation without inheriting manager scope.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants Quote object create/read/edit. Composable into any PSG that needs quoting capability without manager scope.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Quote Creator</label>
    <license>Salesforce</license>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Quote</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>QuoteLineItem</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
